{
  "info": {
    "_postman_id": "renaper-mock-demo",
    "name": "RENAPER Mock",
    "description": "Demo collection for the RENAPER mock on Google Cloud Run.\n\n**Base URL:** `https://renaper-mock-569660039899.us-central1.run.app`\n\n**Important:** Set collection variables `usuario` and `clave` to match the `MOCK_USER` and `MOCK_PASS` env vars configured on Cloud Run (defaults in this file are `mock_user` / `mock_pass` for local dev only).\n\nSynthetic patients: DNI `99000000`–`99000999`. Trigger DNIs `99001000`–`99001003` return specific errors.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://renaper-mock-569660039899.us-central1.run.app"
    },
    {
      "key": "usuario",
      "value": "mock_user"
    },
    {
      "key": "clave",
      "value": "mock_pass"
    }
  ],
